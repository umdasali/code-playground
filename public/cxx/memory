// Lightweight smart pointers for the in-browser playground (the real libc++ <memory> cannot be compiled there).
#pragma once
#include <iosfwd>  // defines the libc++ namespace macros
#include <cstddef>
#include <new>
#include <type_traits>
#include <utility>

_LIBCPP_BEGIN_NAMESPACE_STD

template <typename T> struct default_delete {
  void operator()(T *p) const { delete p; }
};
template <typename T> struct default_delete<T[]> {
  void operator()(T *p) const { delete[] p; }
};

template <typename T, typename D = default_delete<T>>
class unique_ptr {
  T *p_ = nullptr;
  D d_;

 public:
  typedef T element_type;
  unique_ptr() = default;
  unique_ptr(nullptr_t) {}
  explicit unique_ptr(T *p) : p_(p) {}
  unique_ptr(T *p, D d) : p_(p), d_(d) {}
  unique_ptr(const unique_ptr &) = delete;
  unique_ptr &operator=(const unique_ptr &) = delete;
  unique_ptr(unique_ptr &&o) noexcept : p_(o.release()), d_(static_cast<D &&>(o.d_)) {}
  template <typename U, typename E, typename = enable_if_t<is_convertible<U *, T *>::value>>
  unique_ptr(unique_ptr<U, E> &&o) noexcept : p_(o.release()) {}
  ~unique_ptr() { reset(); }
  unique_ptr &operator=(unique_ptr &&o) noexcept { if (this != &o) { reset(o.release()); d_ = static_cast<D &&>(o.d_); } return *this; }
  unique_ptr &operator=(nullptr_t) { reset(); return *this; }

  T *get() const { return p_; }
  T &operator*() const { return *p_; }
  T *operator->() const { return p_; }
  explicit operator bool() const { return p_ != nullptr; }
  T *release() { T *t = p_; p_ = nullptr; return t; }
  void reset(T *p = nullptr) { T *old = p_; p_ = p; if (old) d_(old); }
  void swap(unique_ptr &o) { T *t = p_; p_ = o.p_; o.p_ = t; }
};

template <typename T, typename D>
class unique_ptr<T[], D> {
  T *p_ = nullptr;

 public:
  unique_ptr() = default;
  explicit unique_ptr(T *p) : p_(p) {}
  unique_ptr(const unique_ptr &) = delete;
  unique_ptr &operator=(const unique_ptr &) = delete;
  unique_ptr(unique_ptr &&o) noexcept : p_(o.release()) {}
  ~unique_ptr() { delete[] p_; }
  unique_ptr &operator=(unique_ptr &&o) noexcept { if (this != &o) reset(o.release()); return *this; }
  T *get() const { return p_; }
  T &operator[](size_t i) const { return p_[i]; }
  explicit operator bool() const { return p_ != nullptr; }
  T *release() { T *t = p_; p_ = nullptr; return t; }
  void reset(T *p = nullptr) { T *old = p_; p_ = p; delete[] old; }
};

template <typename T, typename... A>
enable_if_t<!is_array<T>::value, unique_ptr<T>> make_unique(A &&...a) { return unique_ptr<T>(new T(static_cast<A &&>(a)...)); }
template <typename T>
enable_if_t<is_array<T>::value && extent<T>::value == 0, unique_ptr<T>> make_unique(size_t n) { return unique_ptr<T>(new remove_extent_t<T>[n]()); }

template <typename T, typename D> bool operator==(const unique_ptr<T, D> &a, nullptr_t) { return !a; }
template <typename T, typename D> bool operator!=(const unique_ptr<T, D> &a, nullptr_t) { return static_cast<bool>(a); }

namespace pg_detail {
struct ctrl {
  long strong = 1, weak = 1;  // weak counts one reference on behalf of all strong ones
  virtual void destroy() = 0;
  virtual void release_self() = 0;
  virtual ~ctrl() {}
};
template <typename T, typename D> struct ctrl_ptr : ctrl {
  T *p; D d;
  ctrl_ptr(T *p_, D d_) : p(p_), d(d_) {}
  void destroy() override { d(p); }
  void release_self() override { delete this; }
};
template <typename T> struct ctrl_inline : ctrl {
  alignas(T) unsigned char buf[sizeof(T)];
  T *obj() { return reinterpret_cast<T *>(buf); }
  void destroy() override { obj()->~T(); }
  void release_self() override { delete this; }
};
inline void drop_weak(ctrl *c) { if (c && --c->weak == 0) c->release_self(); }
inline void drop_strong(ctrl *c) { if (c && --c->strong == 0) { c->destroy(); drop_weak(c); } }
}  // namespace pg_detail

template <typename T> class weak_ptr;

template <typename T>
class shared_ptr {
  T *p_ = nullptr;
  pg_detail::ctrl *c_ = nullptr;
  template <typename U> friend class shared_ptr;
  template <typename U> friend class weak_ptr;
  struct adopt_t {};
  shared_ptr(adopt_t, T *p, pg_detail::ctrl *c) : p_(p), c_(c) {}
  template <typename U, typename... A> friend shared_ptr<U> make_shared(A &&...);

 public:
  typedef T element_type;
  shared_ptr() = default;
  shared_ptr(nullptr_t) {}
  template <typename U, typename = enable_if_t<is_convertible<U *, T *>::value>>
  explicit shared_ptr(U *p) : p_(p), c_(new pg_detail::ctrl_ptr<U, default_delete<U>>(p, default_delete<U>())) {}
  template <typename U, typename D> shared_ptr(U *p, D d) : p_(p), c_(new pg_detail::ctrl_ptr<U, D>(p, d)) {}
  shared_ptr(const shared_ptr &o) : p_(o.p_), c_(o.c_) { if (c_) c_->strong++; }
  template <typename U, typename = enable_if_t<is_convertible<U *, T *>::value>>
  shared_ptr(const shared_ptr<U> &o) : p_(o.p_), c_(o.c_) { if (c_) c_->strong++; }
  shared_ptr(shared_ptr &&o) noexcept : p_(o.p_), c_(o.c_) { o.p_ = nullptr; o.c_ = nullptr; }
  template <typename U, typename D, typename = enable_if_t<is_convertible<U *, T *>::value>>
  shared_ptr(unique_ptr<U, D> &&u) { U *raw = u.release(); if (raw) { p_ = raw; c_ = new pg_detail::ctrl_ptr<U, D>(raw, D()); } }
  ~shared_ptr() { pg_detail::drop_strong(c_); }
  shared_ptr &operator=(const shared_ptr &o) { shared_ptr(o).swap(*this); return *this; }
  shared_ptr &operator=(shared_ptr &&o) noexcept { shared_ptr(static_cast<shared_ptr &&>(o)).swap(*this); return *this; }
  shared_ptr &operator=(nullptr_t) { reset(); return *this; }

  T *get() const { return p_; }
  T &operator*() const { return *p_; }
  T *operator->() const { return p_; }
  explicit operator bool() const { return p_ != nullptr; }
  long use_count() const { return c_ ? c_->strong : 0; }
  bool unique() const { return use_count() == 1; }
  void reset() { shared_ptr().swap(*this); }
  template <typename U> void reset(U *p) { shared_ptr(p).swap(*this); }
  void swap(shared_ptr &o) { T *p = p_; p_ = o.p_; o.p_ = p; pg_detail::ctrl *c = c_; c_ = o.c_; o.c_ = c; }
};

template <typename T, typename... A>
shared_ptr<T> make_shared(A &&...a) {
  auto *c = new pg_detail::ctrl_inline<T>();
  new (c->buf) T(static_cast<A &&>(a)...);
  return shared_ptr<T>(typename shared_ptr<T>::adopt_t(), c->obj(), c);
}

template <typename T, typename U> bool operator==(const shared_ptr<T> &a, const shared_ptr<U> &b) { return a.get() == b.get(); }
template <typename T, typename U> bool operator!=(const shared_ptr<T> &a, const shared_ptr<U> &b) { return a.get() != b.get(); }
template <typename T> bool operator==(const shared_ptr<T> &a, nullptr_t) { return !a; }
template <typename T> bool operator!=(const shared_ptr<T> &a, nullptr_t) { return static_cast<bool>(a); }

template <typename T>
class weak_ptr {
  T *p_ = nullptr;
  pg_detail::ctrl *c_ = nullptr;

 public:
  weak_ptr() = default;
  weak_ptr(const shared_ptr<T> &s) : p_(s.p_), c_(s.c_) { if (c_) c_->weak++; }
  weak_ptr(const weak_ptr &o) : p_(o.p_), c_(o.c_) { if (c_) c_->weak++; }
  weak_ptr(weak_ptr &&o) noexcept : p_(o.p_), c_(o.c_) { o.p_ = nullptr; o.c_ = nullptr; }
  ~weak_ptr() { pg_detail::drop_weak(c_); }
  weak_ptr &operator=(const weak_ptr &o) { weak_ptr(o).swap(*this); return *this; }
  weak_ptr &operator=(const shared_ptr<T> &s) { weak_ptr(s).swap(*this); return *this; }
  void swap(weak_ptr &o) { T *p = p_; p_ = o.p_; o.p_ = p; pg_detail::ctrl *c = c_; c_ = o.c_; o.c_ = c; }
  void reset() { weak_ptr().swap(*this); }
  long use_count() const { return c_ ? c_->strong : 0; }
  bool expired() const { return use_count() == 0; }
  shared_ptr<T> lock() const {
    if (expired()) return shared_ptr<T>();
    c_->strong++;
    return shared_ptr<T>(typename shared_ptr<T>::adopt_t(), p_, c_);
  }
};

_LIBCPP_END_NAMESPACE_STD
