// Lightweight std::string for the in-browser playground (the real libc++ <string> cannot be compiled there).
#pragma once
#include <iosfwd>
#include <cstddef>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <initializer_list>
#include <utility>

// libc++'s <iosfwd> (pulled in by <iterator>, <stdexcept>, ...) already declares std::string as
// basic_string<char>, so the playground's implementation is an explicit specialization of that.
_LIBCPP_BEGIN_NAMESPACE_STD

template <>
class basic_string<char, char_traits<char>, allocator<char>> {
 public:
  typedef basic_string string;

 private:
  char *d_;
  size_t n_, cap_;

  void grow(size_t need) {
    if (need <= cap_) return;
    size_t c = cap_ * 2 > need ? cap_ * 2 : need;
    char *p = static_cast<char *>(malloc(c + 1));
    memcpy(p, d_, n_ + 1);
    if (d_ != sso_) free(d_);
    d_ = p;
    cap_ = c;
  }
  char sso_[16];

 public:
  static const size_t npos = static_cast<size_t>(-1);
  typedef char value_type;
  typedef char *iterator;
  typedef const char *const_iterator;

  basic_string() : d_(sso_), n_(0), cap_(15) { sso_[0] = 0; }
  basic_string(const char *s) : basic_string() { append(s, strlen(s)); }
  basic_string(const char *s, size_t n) : basic_string() { append(s, n); }
  basic_string(size_t n, char c) : basic_string() { for (size_t i = 0; i < n; i++) push_back(c); }
  basic_string(const string &o) : basic_string() { append(o.d_, o.n_); }
  basic_string(const string &o, size_t pos, size_t len = npos) : basic_string() { append(o.substr(pos, len)); }
  basic_string(string &&o) noexcept : basic_string() { *this = static_cast<string &&>(o); }
  basic_string(initializer_list<char> il) : basic_string() { for (char c : il) push_back(c); }
  ~basic_string() { if (d_ != sso_) free(d_); }

  string &operator=(const string &o) {
    if (this != &o) { n_ = 0; d_[0] = 0; append(o.d_, o.n_); }
    return *this;
  }
  string &operator=(string &&o) noexcept {
    if (this == &o) return *this;
    if (o.d_ == o.sso_) { n_ = 0; d_[0] = 0; append(o.d_, o.n_); }
    else {
      if (d_ != sso_) free(d_);
      d_ = o.d_; n_ = o.n_; cap_ = o.cap_;
      o.d_ = o.sso_; o.n_ = 0; o.cap_ = 15; o.sso_[0] = 0;
    }
    return *this;
  }
  string &operator=(const char *s) { n_ = 0; d_[0] = 0; return append(s, strlen(s)); }
  string &operator=(char c) { n_ = 0; d_[0] = 0; push_back(c); return *this; }

  size_t size() const { return n_; }
  size_t length() const { return n_; }
  size_t capacity() const { return cap_; }
  bool empty() const { return n_ == 0; }
  const char *c_str() const { return d_; }
  const char *data() const { return d_; }
  char *data() { return d_; }
  void reserve(size_t n) { grow(n); }
  void clear() { n_ = 0; d_[0] = 0; }

  char &operator[](size_t i) { return d_[i]; }
  const char &operator[](size_t i) const { return d_[i]; }
  char &at(size_t i) { if (i >= n_) { fputs("std::string::at: index out of range\n", stderr); abort(); } return d_[i]; }
  const char &at(size_t i) const { if (i >= n_) { fputs("std::string::at: index out of range\n", stderr); abort(); } return d_[i]; }
  char &front() { return d_[0]; }
  char &back() { return d_[n_ - 1]; }
  const char &front() const { return d_[0]; }
  const char &back() const { return d_[n_ - 1]; }

  iterator begin() { return d_; }
  iterator end() { return d_ + n_; }
  const_iterator begin() const { return d_; }
  const_iterator end() const { return d_ + n_; }
  const_iterator cbegin() const { return d_; }
  const_iterator cend() const { return d_ + n_; }

  void push_back(char c) { grow(n_ + 1); d_[n_++] = c; d_[n_] = 0; }
  void pop_back() { if (n_) d_[--n_] = 0; }
  string &append(const char *s, size_t n) { grow(n_ + n); memcpy(d_ + n_, s, n); n_ += n; d_[n_] = 0; return *this; }
  string &append(const char *s) { return append(s, strlen(s)); }
  string &append(const string &o) { string tmp(o); return append(tmp.d_, tmp.n_); }
  string &append(size_t n, char c) { while (n--) push_back(c); return *this; }
  string &operator+=(const string &o) { return append(o); }
  string &operator+=(const char *s) { return append(s); }
  string &operator+=(char c) { push_back(c); return *this; }

  string substr(size_t pos = 0, size_t len = npos) const {
    if (pos > n_) { fputs("std::string::substr: position out of range\n", stderr); abort(); }
    if (len > n_ - pos) len = n_ - pos;
    return string(d_ + pos, len);
  }
  size_t find(char c, size_t pos = 0) const {
    for (size_t i = pos; i < n_; i++) if (d_[i] == c) return i;
    return npos;
  }
  size_t find(const char *s, size_t pos = 0) const {
    if (pos > n_) return npos;
    const char *p = strstr(d_ + pos, s);
    return p ? static_cast<size_t>(p - d_) : npos;
  }
  size_t find(const string &s, size_t pos = 0) const { return find(s.d_, pos); }
  size_t rfind(char c, size_t pos = npos) const {
    if (n_ == 0) return npos;
    for (size_t i = (pos >= n_ ? n_ - 1 : pos) + 1; i-- > 0;) if (d_[i] == c) return i;
    return npos;
  }
  string &insert(size_t pos, const string &s) {
    string tail = substr(pos);
    n_ = pos; d_[n_] = 0;
    append(s); append(tail);
    return *this;
  }
  string &erase(size_t pos = 0, size_t len = npos) {
    if (pos >= n_) return *this;
    if (len > n_ - pos) len = n_ - pos;
    memmove(d_ + pos, d_ + pos + len, n_ - pos - len + 1);
    n_ -= len;
    return *this;
  }
  void resize(size_t n, char c = 0) {
    if (n < n_) { n_ = n; d_[n_] = 0; }
    else while (n_ < n) push_back(c);
  }
  void swap(string &o) { string t(static_cast<string &&>(o)); o = static_cast<string &&>(*this); *this = static_cast<string &&>(t); }
  int compare(const string &o) const {
    size_t m = n_ < o.n_ ? n_ : o.n_;
    int r = memcmp(d_, o.d_, m);
    return r ? r : (n_ < o.n_ ? -1 : n_ > o.n_ ? 1 : 0);
  }
};

inline string operator+(const string &a, const string &b) { string r(a); r += b; return r; }
inline string operator+(const string &a, const char *b) { string r(a); r += b; return r; }
inline string operator+(const char *a, const string &b) { string r(a); r += b; return r; }
inline string operator+(const string &a, char b) { string r(a); r += b; return r; }
inline string operator+(char a, const string &b) { string r(1, a); r += b; return r; }
inline string operator+(string &&a, const string &b) { a += b; return static_cast<string &&>(a); }
inline string operator+(string &&a, const char *b) { a += b; return static_cast<string &&>(a); }

inline bool operator==(const string &a, const string &b) { return a.size() == b.size() && memcmp(a.data(), b.data(), a.size()) == 0; }
inline bool operator==(const string &a, const char *b) { return strcmp(a.c_str(), b) == 0; }
inline bool operator==(const char *a, const string &b) { return strcmp(a, b.c_str()) == 0; }
inline bool operator!=(const string &a, const string &b) { return !(a == b); }
inline bool operator!=(const string &a, const char *b) { return !(a == b); }
inline bool operator!=(const char *a, const string &b) { return !(a == b); }
inline bool operator<(const string &a, const string &b) { return a.compare(b) < 0; }
inline bool operator>(const string &a, const string &b) { return a.compare(b) > 0; }
inline bool operator<=(const string &a, const string &b) { return a.compare(b) <= 0; }
inline bool operator>=(const string &a, const string &b) { return a.compare(b) >= 0; }

inline string to_string(int v) { char b[16]; snprintf(b, sizeof b, "%d", v); return b; }
inline string to_string(unsigned v) { char b[16]; snprintf(b, sizeof b, "%u", v); return b; }
inline string to_string(long v) { char b[32]; snprintf(b, sizeof b, "%ld", v); return b; }
inline string to_string(unsigned long v) { char b[32]; snprintf(b, sizeof b, "%lu", v); return b; }
inline string to_string(long long v) { char b[32]; snprintf(b, sizeof b, "%lld", v); return b; }
inline string to_string(unsigned long long v) { char b[32]; snprintf(b, sizeof b, "%llu", v); return b; }
inline string to_string(double v) { char b[400]; snprintf(b, sizeof b, "%f", v); return b; }

inline int stoi(const string &s) { return static_cast<int>(strtol(s.c_str(), nullptr, 10)); }
inline long stol(const string &s) { return strtol(s.c_str(), nullptr, 10); }
inline long long stoll(const string &s) { return strtoll(s.c_str(), nullptr, 10); }
inline double stod(const string &s) { return strtod(s.c_str(), nullptr); }
inline float stof(const string &s) { return strtof(s.c_str(), nullptr); }

_LIBCPP_END_NAMESPACE_STD
