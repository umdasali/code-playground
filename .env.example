# "docker" (default, sandboxed) or "local" (dev only: runs code directly on your machine)
RUNNER_MODE=docker
RUN_TIMEOUT_MS=10000
SANDBOX_IMAGE_GCC=gcc:14
SANDBOX_IMAGE_LINUX=ubuntu:24.04

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=playground
MYSQL_SESSION_SECRET=change-me

# Terminal tab (WebSocket PTY server). Bound to localhost by default.
TERMINAL_PORT=3001
NEXT_PUBLIC_TERMINAL_PORT=3001
# TERMINAL_HOST=127.0.0.1
# TERMINAL_ALLOWED_ORIGINS=https://your-site.example   # required when not on localhost
